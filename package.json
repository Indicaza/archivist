{
  "name": "archivist",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first AI librarian desktop app.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "check-node": "node scripts/check-node-version.mjs",
    "test:chat-agents": "npm run check-node && npm run build -w backend && node scripts/test-chat-agent-rosters.mjs",
    "test:collections": "npm run check-node && npm run build -w backend && node scripts/test-collections.mjs",
    "test:ai-runtime": "npm run check-node && npm run build -w backend && node scripts/test-ai-runtime.mjs",
    "test:library-index": "npm run check-node && node scripts/test-library-index.mjs",
    "dev": "./scripts/qt-dev-detached --follow",
    "dev:detached": "./scripts/qt-dev-detached",
    "dev:foreground": "./scripts/qt-dev",
    "dev:logs": "tail -n 200 backend/data/runtime/logs/backend.log backend/data/runtime/logs/frontend.log",
    "dev:logs:follow": "tail -f backend/data/runtime/logs/backend.log backend/data/runtime/logs/frontend.log",
    "dev:frontend": "./scripts/qt-dev-detached --follow",
    "dev:qt": "npm run dev:frontend",
    "dev:stop": "./scripts/qt-stop",
    "diagnose:navigation": "./scripts/diagnose-navigation",
    "diagnose:language-support": "node scripts/diagnose-language-support.mjs",
    "check:language-support": "npm run check-node && npm run check:ide -w frontend && npm run build -w backend && npm run lsp:doctor",
    "clean:language-test-lab": "rimraf language-test-lab/rust/target language-test-lab/rust/Cargo.lock language-test-lab/cpp/build language-test-lab/cpp/compile_commands.json language-test-lab/python/__pycache__ language-test-lab/intentional-errors/__pycache__",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run check-node && npm run build -w backend && npm run build:ide && npm run build:frontend",
    "build:frontend": "./scripts/qt-build",
    "build:qt": "npm run build:frontend",
    "frontend:configure": "./scripts/qt-configure",
    "qt:configure": "npm run frontend:configure",
    "frontend:run": "./scripts/qt-run",
    "qt:run": "npm run frontend:run",
    "lsp:doctor": "node scripts/language-tools.mjs doctor",
    "lsp:install": "node scripts/language-tools.mjs install",
    "lsp:check": "node scripts/language-tools.mjs check",
    "lsp:update": "node scripts/language-tools.mjs update",
    "lsp:set": "node scripts/language-tools.mjs set",
    "audit": "npm audit --workspaces",
    "clean": "rimraf node_modules frontend/node_modules backend/node_modules frontend/dist/ide build/frontend-debug build/qt-debug package-lock.json frontend/package-lock.json backend/package-lock.json",
    "build:ide": "node scripts/build-ide.mjs --force",
    "build:ide:cached": "node scripts/build-ide.mjs",
    "icons:vendor": "node scripts/vendor-icons.mjs",
    "check:pre-pr": "./scripts/pre-pr"
  },
  "devDependencies": {
    "@iconify-json/codicon": "1.2.63",
    "@iconify-json/devicon-plain": "1.2.57",
    "@iconify-json/file-icons": "1.2.1",
    "@iconify-json/streamline-flex": "1.2.3",
    "bash-language-server": "5.6.0",
    "pyright": "1.1.411",
    "rimraf": "6.1.3",
    "typescript": "6.0.2",
    "typescript-language-server": "5.3.0",
    "yaml-language-server": "1.24.0"
  }
}
