#!/usr/bin/env bash
# Builds Archivist and launches it in the background, logging to
# backend/data/runtime/logs/frontend.log. --follow streams the log and stops
# the app on Ctrl+C.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNTIME_DIR="$ROOT/backend/data/runtime"
LOG_DIR="$RUNTIME_DIR/logs"
FRONTEND_PID_FILE="$RUNTIME_DIR/qt-dev-frontend.pid"
FRONTEND_LOG="$LOG_DIR/frontend.log"
BUILD_DIR="$ROOT/build/frontend-debug"
APP_BINARY="$BUILD_DIR/archivist-qt.app/Contents/MacOS/archivist-qt"
PLAIN_BINARY="$BUILD_DIR/archivist-qt"
STARTED=0
FOLLOW_LOGS=false
TAIL_PID=""

if [[ "${1:-}" == "--follow" ]]; then
  FOLLOW_LOGS=true
elif [[ $# -gt 0 ]]; then
  printf 'Usage: %s [--follow]\n' "$0" >&2
  exit 2
fi

cleanup_failed_start() {
  local exit_code=$?

  trap - ERR INT TERM HUP

  if (( STARTED == 1 )); then
    "$ROOT/scripts/qt-stop" >/dev/null 2>&1 || true
  fi

  exit "$exit_code"
}

trap cleanup_failed_start ERR INT TERM HUP

cd "$ROOT"

# Node is only a build tool now: it bundles the IDE panel's web files.
node scripts/check-node-version.mjs

printf 'Preparing Archivist IDE shell...\n'
npm run build:ide:cached

mkdir -p "$LOG_DIR"

# Stops older app instances (and any Node backend left from older builds).
"$ROOT/scripts/qt-stop" >/dev/null 2>&1 || true

printf 'Building Archivist...\n'
"$ROOT/scripts/qt-build"

if [[ -x "$APP_BINARY" ]]; then
  FRONTEND_BINARY="$APP_BINARY"
elif [[ -x "$PLAIN_BINARY" ]]; then
  FRONTEND_BINARY="$PLAIN_BINARY"
else
  printf 'Archivist binary was not found after the build.\n' >&2
  exit 1
fi

: > "$FRONTEND_LOG"

printf 'Launching Archivist in the background...\n'
nohup "$FRONTEND_BINARY" \
  >>"$FRONTEND_LOG" \
  2>&1 \
  </dev/null &
FRONTEND_PID=$!
printf '%s\n' "$FRONTEND_PID" > "$FRONTEND_PID_FILE"
STARTED=1

sleep 0.75

if ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
  printf 'Archivist exited during startup.\n' >&2
  printf '\nLog:\n' >&2
  tail -n 100 "$FRONTEND_LOG" >&2 || true
  exit 1
fi

frontend_instance_count="$({
  pgrep -f -- "$APP_BINARY" 2>/dev/null || true
  pgrep -f -- "$PLAIN_BINARY" 2>/dev/null || true
} | sort -u | wc -l | tr -d '[:space:]')"

if [[ "$frontend_instance_count" != "1" ]]; then
  printf 'Expected one Archivist instance, found %s. Cleaning up.\n' \
    "$frontend_instance_count" >&2
  exit 1
fi

trap - ERR INT TERM HUP
STARTED=0

printf '\nArchivist is running.\n'
printf 'PID: %s\n' "$FRONTEND_PID"
printf 'Log: %s\n' "$FRONTEND_LOG"

if [[ "$FOLLOW_LOGS" != true ]]; then
  printf '\nFollow the log:\n'
  printf '  npm run dev:logs:follow\n'
  printf 'Stop Archivist:\n'
  printf '  npm run dev:stop\n'
  exit 0
fi

cleanup_live_session() {
  local exit_code=$?

  trap - EXIT INT TERM HUP

  if [[ -n "$TAIL_PID" ]] && kill -0 "$TAIL_PID" 2>/dev/null; then
    kill "$TAIL_PID" 2>/dev/null || true
    wait "$TAIL_PID" 2>/dev/null || true
  fi

  printf '\nStopping Archivist...\n'
  "$ROOT/scripts/qt-stop" || true
  exit "$exit_code"
}

trap cleanup_live_session EXIT INT TERM HUP

printf '\nStreaming the Archivist log. Press Ctrl+C to stop.\n\n'
tail -n 30 -F "$FRONTEND_LOG" &
TAIL_PID=$!

while kill -0 "$FRONTEND_PID" 2>/dev/null; do
  sleep 1
done

printf '\nArchivist exited.\n' >&2
