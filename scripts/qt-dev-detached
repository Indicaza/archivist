#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PORT="3333"
HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/api/health"
RUNTIME_DIR="$ROOT/backend/data/runtime"
LOG_DIR="$RUNTIME_DIR/logs"
BACKEND_PID_FILE="$RUNTIME_DIR/qt-dev-backend.pid"
FRONTEND_PID_FILE="$RUNTIME_DIR/qt-dev-frontend.pid"
BACKEND_LOG="$LOG_DIR/backend.log"
FRONTEND_LOG="$LOG_DIR/frontend.log"
BUILD_DIR="$ROOT/build/frontend-debug"
APP_BINARY="$BUILD_DIR/archivist-qt.app/Contents/MacOS/archivist-qt"
PLAIN_BINARY="$BUILD_DIR/archivist-qt"
STARTED=0

cleanup_failed_start() {
  local exit_code=$?

  trap - ERR INT TERM HUP

  if (( STARTED == 1 )); then
    "$ROOT/scripts/qt-stop" >/dev/null 2>&1 || true
  fi

  exit "$exit_code"
}

trap cleanup_failed_start ERR INT TERM HUP

cd "$ROOT"

node scripts/check-node-version.mjs

if ! node -e 'const Database = require("better-sqlite3"); const database = new Database(":memory:"); database.close();' >/dev/null 2>&1; then
  printf 'better-sqlite3 is not built for %s.\n' "$(node --version)" >&2
  printf 'Run: nvm use && npm rebuild better-sqlite3\n' >&2
  exit 1
fi

printf 'Preparing Archivist IDE shell...\n'
npm run build:ide:cached

mkdir -p "$LOG_DIR"

"$ROOT/scripts/qt-stop" >/dev/null 2>&1 || true

: > "$BACKEND_LOG"
: > "$FRONTEND_LOG"

printf 'Starting Archivist backend on port %s...\n' "$BACKEND_PORT"
nohup npm run dev:backend \
  >>"$BACKEND_LOG" \
  2>&1 \
  </dev/null &
BACKEND_PID=$!
printf '%s\n' "$BACKEND_PID" > "$BACKEND_PID_FILE"
STARTED=1

for _ in {1..120}; do
  if curl --silent --fail "$HEALTH_URL" >/dev/null 2>&1; then
    break
  fi

  if ! kill -0 "$BACKEND_PID" 2>/dev/null; then
    printf 'Archivist backend exited before becoming healthy.\n' >&2
    printf '\nBackend log:\n' >&2
    tail -n 100 "$BACKEND_LOG" >&2 || true
    exit 1
  fi

  sleep 0.25
done

if ! curl --silent --fail "$HEALTH_URL" >/dev/null 2>&1; then
  printf 'Archivist backend did not become healthy at %s.\n' "$HEALTH_URL" >&2
  printf '\nBackend log:\n' >&2
  tail -n 100 "$BACKEND_LOG" >&2 || true
  exit 1
fi

printf 'Archivist backend is healthy.\n'
tail -n 20 "$BACKEND_LOG" || true

printf 'Building the native frontend...\n'
"$ROOT/scripts/qt-build"

if [[ -x "$APP_BINARY" ]]; then
  FRONTEND_BINARY="$APP_BINARY"
elif [[ -x "$PLAIN_BINARY" ]]; then
  FRONTEND_BINARY="$PLAIN_BINARY"
else
  printf 'Archivist frontend binary was not found after the build.\n' >&2
  exit 1
fi

printf 'Launching the native frontend in the background...\n'
nohup "$FRONTEND_BINARY" \
  >>"$FRONTEND_LOG" \
  2>&1 \
  </dev/null &
FRONTEND_PID=$!
printf '%s\n' "$FRONTEND_PID" > "$FRONTEND_PID_FILE"

sleep 0.75

if ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
  printf 'Archivist frontend exited during startup.\n' >&2
  printf '\nFrontend log:\n' >&2
  tail -n 100 "$FRONTEND_LOG" >&2 || true
  exit 1
fi

trap - ERR INT TERM HUP
STARTED=0

printf '\nArchivist is running in the background.\n'
printf 'Backend PID: %s\n' "$BACKEND_PID"
printf 'Frontend PID: %s\n' "$FRONTEND_PID"
printf 'Backend log: %s\n' "$BACKEND_LOG"
printf 'Frontend log: %s\n' "$FRONTEND_LOG"
printf '\nShow recent logs:\n'
printf '  npm run dev:logs\n'
printf 'Follow live logs:\n'
printf '  npm run dev:logs:follow\n'
printf 'Stop Archivist:\n'
printf '  npm run dev:stop\n'
