#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PORT="3333"
BUILD_DIR="$ROOT/build/frontend-debug"
APP_BINARY="$BUILD_DIR/archivist-qt.app/Contents/MacOS/archivist-qt"
PLAIN_BINARY="$BUILD_DIR/archivist-qt"
RUNTIME_DIR="$ROOT/backend/data/runtime"
LOG_DIR="$RUNTIME_DIR/logs"
BACKEND_LOG="$LOG_DIR/backend.log"
FRONTEND_LOG="$LOG_DIR/frontend.log"
PID_FILE="$RUNTIME_DIR/qt-dev-backend.pid"
FRONTEND_PID_FILE="$RUNTIME_DIR/qt-dev-frontend.pid"
PROCESS_TREE=()

collect_process_tree() {
  local pid="$1"
  local child

  PROCESS_TREE+=("$pid")

  while IFS= read -r child; do
    [[ -n "$child" ]] || continue
    collect_process_tree "$child"
  done < <(pgrep -P "$pid" 2>/dev/null || true)
}

terminate_process_tree() {
  local root_pid="$1"
  local pid

  [[ "$root_pid" =~ ^[0-9]+$ ]] || return 0

  if ! kill -0 "$root_pid" 2>/dev/null; then
    return 0
  fi

  PROCESS_TREE=()
  collect_process_tree "$root_pid"

  kill -TERM "${PROCESS_TREE[@]}" 2>/dev/null || true

  for _ in {1..40}; do
    for pid in "${PROCESS_TREE[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        sleep 0.1
        continue 2
      fi
    done

    return 0
  done

  for pid in "${PROCESS_TREE[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  done
}

process_working_directory() {
  local pid="$1"

  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null \
    | sed -n 's/^n//p' \
    | head -n 1
}

repository_process_root() {
  local current_pid="$1"
  local candidate_pid="$1"
  local parent_pid
  local parent_cwd
  local parent_command

  while true; do
    parent_pid="$(ps -p "$current_pid" -o ppid= 2>/dev/null | tr -d '[:space:]')"

    if [[ ! "$parent_pid" =~ ^[0-9]+$ ]] || (( parent_pid <= 1 )); then
      break
    fi

    parent_cwd="$(process_working_directory "$parent_pid")"
    parent_command="$(ps -p "$parent_pid" -o command= 2>/dev/null || true)"

    if [[ "$parent_cwd" != "$ROOT" && "$parent_cwd" != "$ROOT/"* ]]; then
      break
    fi

    if [[ ! "$parent_command" =~ (node|npm|npx|tsx|dev:backend|qt-dev) ]]; then
      break
    fi

    candidate_pid="$parent_pid"
    current_pid="$parent_pid"
  done

  printf '%s\n' "$candidate_pid"
}

stopped=0

# Clean up orphaned log followers from interrupted development shells.
# They do not create extra app instances, but they duplicate every line in
# the terminal and make runtime diagnosis misleading.
stale_tail_pids="$(pgrep -f -- "tail .*${BACKEND_LOG} .*${FRONTEND_LOG}" 2>/dev/null || true)"

for stale_tail_pid in $stale_tail_pids; do
  [[ "$stale_tail_pid" =~ ^[0-9]+$ ]] || continue
  [[ "$stale_tail_pid" != "$$" ]] || continue

  if kill -0 "$stale_tail_pid" 2>/dev/null; then
    printf 'Stopping stale Archivist log follower (%s)...\n' "$stale_tail_pid"
    kill -TERM "$stale_tail_pid" 2>/dev/null || true
    stopped=1
  fi
done

if [[ -f "$FRONTEND_PID_FILE" ]]; then
  frontend_pid="$(tr -d '[:space:]' < "$FRONTEND_PID_FILE")"

  if [[ "$frontend_pid" =~ ^[0-9]+$ ]] && kill -0 "$frontend_pid" 2>/dev/null; then
    frontend_command="$(ps -p "$frontend_pid" -o command= 2>/dev/null || true)"

    if [[ "$frontend_command" == *"archivist-qt"* ]]; then
      printf 'Stopping managed Archivist frontend process tree (%s)...\n' "$frontend_pid"
      terminate_process_tree "$frontend_pid"
      stopped=1
    else
      printf 'Leaving unrelated process %s alone.\n' "$frontend_pid" >&2
    fi
  fi

  rm -f "$FRONTEND_PID_FILE"
fi

# PID files only describe the newest launch. Sweep any older native frontend
# instances from this exact repository before touching the backend. This avoids
# running a stale WebEngine bundle beside the newly built application.
stale_frontend_pids="$({
  pgrep -f -- "$APP_BINARY" 2>/dev/null || true
  pgrep -f -- "$PLAIN_BINARY" 2>/dev/null || true
} | sort -u)"

for stale_frontend_pid in $stale_frontend_pids; do
  [[ "$stale_frontend_pid" =~ ^[0-9]+$ ]] || continue
  [[ "$stale_frontend_pid" != "$$" ]] || continue

  if ! kill -0 "$stale_frontend_pid" 2>/dev/null; then
    continue
  fi

  stale_frontend_command="$(ps -p "$stale_frontend_pid" -o command= 2>/dev/null || true)"

  if [[ "$stale_frontend_command" == *"$APP_BINARY"* ]] \
    || [[ "$stale_frontend_command" == *"$PLAIN_BINARY"* ]]; then
    printf 'Stopping stale Archivist frontend process tree (%s)...\n' "$stale_frontend_pid"
    terminate_process_tree "$stale_frontend_pid"
    stopped=1
  fi
done

if [[ -f "$PID_FILE" ]]; then
  managed_pid="$(tr -d '[:space:]' < "$PID_FILE")"

  if [[ "$managed_pid" =~ ^[0-9]+$ ]] && kill -0 "$managed_pid" 2>/dev/null; then
    managed_cwd="$(process_working_directory "$managed_pid")"

    if [[ "$managed_cwd" == "$ROOT" || "$managed_cwd" == "$ROOT/"* ]]; then
      printf 'Stopping managed Archivist backend process tree (%s)...\n' "$managed_pid"
      terminate_process_tree "$managed_pid"
      stopped=1
    fi
  fi

  rm -f "$PID_FILE"
fi

listener_pids="$(lsof -tiTCP:"$BACKEND_PORT" -sTCP:LISTEN 2>/dev/null || true)"

for listener_pid in $listener_pids; do
  listener_cwd="$(process_working_directory "$listener_pid")"

  if [[ "$listener_cwd" == "$ROOT" || "$listener_cwd" == "$ROOT/"* ]]; then
    listener_root_pid="$(repository_process_root "$listener_pid")"
    printf 'Stopping stale Archivist backend process tree (%s)...\n' "$listener_root_pid"
    terminate_process_tree "$listener_root_pid"
    stopped=1
  else
    printf 'Leaving unrelated listener %s on port %s alone.\n' \
      "$listener_pid" \
      "$BACKEND_PORT" >&2
  fi
done

if (( stopped == 0 )); then
  printf 'No managed Archivist development processes were running.\n'
else
  printf 'Archivist development processes stopped.\n'
fi
