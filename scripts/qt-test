#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_DIR="$ROOT/frontend"
BUILD_DIR="$ROOT/build/frontend-test"

if command -v brew >/dev/null 2>&1; then
  QT_PREFIX="$(brew --prefix)"
else
  QT_PREFIX=""
fi

cmake \
  -S "$SOURCE_DIR" \
  -B "$BUILD_DIR" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Debug \
  -DARCHIVIST_BUILD_TESTS=ON \
  ${QT_PREFIX:+-DCMAKE_PREFIX_PATH="$QT_PREFIX"}

# Build every test CTest knows about (each test is named after its target),
# so a test added to CMakeLists.txt is never left unbuilt ("Not Run").
TEST_TARGETS=()
while IFS= read -r name; do
  TEST_TARGETS+=("$name")
done < <(ctest --test-dir "$BUILD_DIR" -N | sed -n 's/^ *Test *#[0-9]*: *//p')

if [ "${#TEST_TARGETS[@]}" -eq 0 ]; then
  echo "qt-test: CTest lists no tests in $BUILD_DIR" >&2
  exit 1
fi

cmake --build "$BUILD_DIR" --target "${TEST_TARGETS[@]}"
ctest --test-dir "$BUILD_DIR" --output-on-failure
