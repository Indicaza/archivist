#!/usr/bin/env bash
# Builds and runs Archivist in the foreground. The data layer, AI runtime and
# IDE host all run inside the app now, so there is no backend to start.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT"

# Node is only a build tool now: it bundles the IDE panel's web files.
node scripts/check-node-version.mjs

printf 'Preparing Archivist IDE shell...\n'
npm run build:ide:cached

# Stops older app instances (and any Node backend left from older builds).
"$ROOT/scripts/qt-stop" >/dev/null 2>&1 || true

printf 'Building and launching Archivist...\n'
exec "$ROOT/scripts/qt-run"
