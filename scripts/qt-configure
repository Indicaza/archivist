#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_DIR="$ROOT/frontend"
BUILD_DIR="$ROOT/build/frontend-debug"
CACHE_FILE="$BUILD_DIR/CMakeCache.txt"

if [[ $# -gt 1 || ( $# -eq 1 && "${1:-}" != "--if-needed" ) ]]; then
  printf 'Usage: %s [--if-needed]\n' "$0" >&2
  exit 2
fi

if [[ "${1:-}" == "--if-needed" ]] && bash "$ROOT/scripts/qt-build-cache-valid" "$SOURCE_DIR" "$BUILD_DIR"; then
  printf 'CMake cache compatible; Ninja will check regeneration inputs.\n'
  exit 0
fi

if command -v brew >/dev/null 2>&1; then
  QT_PREFIX="$(brew --prefix)"
else
  QT_PREFIX=""
fi

if [[ -f "$CACHE_FILE" ]]; then
  CACHED_SOURCE="$(
    sed -n 's/^CMAKE_HOME_DIRECTORY:INTERNAL=//p' "$CACHE_FILE"
  )"

  if [[ "$CACHED_SOURCE" != "$SOURCE_DIR" ]]; then
    printf 'Resetting stale frontend CMake cache...\n'
    rm -rf "$BUILD_DIR"
  fi
fi

cmake \
  -S "$SOURCE_DIR" \
  -B "$BUILD_DIR" \
  -G Ninja \
  -DCMAKE_BUILD_TYPE=Debug \
  ${QT_PREFIX:+-DCMAKE_PREFIX_PATH="$QT_PREFIX"}
